# Multi-stage Dockerfile for PhumSpace NestJS Backend API
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root and package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/contracts ./packages/contracts
COPY apps/api ./apps/api

# Enable corepack and install dependencies
RUN corepack enable && corepack prepare pnpm@9 --activate
RUN pnpm install --frozen-lockfile
RUN pnpm --filter contracts build
RUN pnpm --filter api prisma:generate
RUN pnpm --filter api build

# Production Runtime Stage
FROM node:20-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001

# Run as non-root user
USER node

COPY --chown=node:node --from=builder /app/node_modules ./node_modules
COPY --chown=node:node --from=builder /app/packages/contracts ./packages/contracts
COPY --chown=node:node --from=builder /app/apps/api ./apps/api

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3001/api/v1/health/liveness || exit 1

CMD ["node", "apps/api/dist/src/main.js"]
