# PhumSpace — bien moi truong mau cho Local/Demo (Docker Compose).
# Sao chep thanh .env va dieu chinh khi can. Khong commit .env that.

NODE_ENV=development

# --- Postgres (heritage/place/iam/... schemas trong 1 cluster, xem packages/db) ---
POSTGRES_USER=phumspace
POSTGRES_PASSWORD=phumspace_dev_password
POSTGRES_DB=phumspace
POSTGRES_PORT=5432
DATABASE_URL=postgres://phumspace:phumspace_dev_password@localhost:5432/phumspace

# --- Redis (cache, BullMQ, rate limit) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO, S3-compatible, thay the Google Cloud Storage o MVP) ---
MINIO_ROOT_USER=phumspace
MINIO_ROOT_PASSWORD=phumspace_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MEDIA_BUCKET=phumspace-media
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1

# --- API / Worker ---
API_PORT=3001
WEB_BASE_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=PhumSpace <no-reply@example.com>
MFA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
JWT_ACCESS_SECRET=change_me_dev_only
JWT_REFRESH_SECRET=change_me_dev_only_too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Web (Next.js PWA) ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# --- Google Gemini (AI Scanner) — de trong o M0, cau hinh that o M3 ---
GEMINI_API_KEY=
GEMINI_VISION_MODEL_ALIAS=vision_fast
GEMINI_SYNTHESIS_MODEL_ALIAS=grounded_quality

# --- Nguong AI Scanner (AI_Specification.docx muc 3) — chinh o day, khong hard-code trong code ---
SCANNER_CONFIDENCE_MATCH_THRESHOLD=0.78
SCANNER_CONFIDENCE_SUGGEST_THRESHOLD=0.55
