{
  "name": "@phumspace/db",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "migrate:up": "node-pg-migrate up --envPath ../../.env",
    "migrate:down": "node-pg-migrate down --envPath ../../.env",
    "migrate:create": "node-pg-migrate create --envPath ../../.env",
    "seed": "ts-node scripts/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --config ../../eslint.config.mjs --max-warnings=0",
    "test": "echo 'packages/db: chua co unit test o M0, migration duoc kiem tra qua CI migration-check job'",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "node-pg-migrate": "^7.9.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.10",
    "@types/node": "^22.9.0"
  }
}
