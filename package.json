{
  "name": "phumspace-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -c \"cyan,magenta\" \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter contracts build && pnpm --filter api build && pnpm --filter web build",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test",
    "e2e": "pnpm --filter web e2e",
    "passport:rebuild-points": "pnpm --filter api passport:rebuild-points",
    "prisma:generate": "pnpm --filter api prisma:generate",
    "prisma:migrate": "pnpm --filter api prisma:migrate",
    "prisma:seed": "pnpm --filter api prisma:seed",
    "prisma:studio": "pnpm --filter api exec prisma studio"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
