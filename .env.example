# =================================================================
# PhumSpace Monorepo Root Environment Variables Template
# Copy to .env for local development
# =================================================================

# Server & Network Ports
NODE_ENV=development
PORT_WEB=3000
PORT_API=3001

# PostgreSQL Database (Docker & Prisma)
POSTGRES_PORT=5432
POSTGRES_DB=phumspace
POSTGRES_USER=phumspace
POSTGRES_PASSWORD=phumspace_dev_password
DATABASE_URL="postgresql://phumspace:phumspace_dev_password@localhost:5432/phumspace?schema=public"

# Public API Base URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# Staff Admin Authentication & RBAC (Sprint 6B.1 / 6B.2)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_ALLOWED_ORIGIN=http://localhost:3000

# AI Cultural Scanner (Gemini API - Sprint 4A)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT_MS=10000

# Google Maps Platform (Sprint 3) & Google GIS Client ID for Web Frontend
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
