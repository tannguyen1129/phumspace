{
  "name": "phumspace",
  "private": true,
  "version": "0.1.0",
  "description": "PhumSpace monorepo — nen tang du lich so ve van hoa Khmer Nam Bo (PhumData knowledge base).",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm run build && pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "smoke:web": "node scripts/smoke-web.mjs",
    "e2e": "playwright test",
    "e2e:desktop": "playwright test --project=desktop-chromium",
    "e2e:mobile": "playwright test --project=mobile-chromium",
    "dev:api": "pnpm --filter @phumspace/api run start:dev",
    "dev:worker": "pnpm --filter @phumspace/worker run start:dev",
    "dev:web": "pnpm --filter @phumspace/web run dev",
    "migrate": "pnpm --filter @phumspace/db run migrate:up",
    "migrate:down": "pnpm --filter @phumspace/db run migrate:down",
    "seed": "pnpm --filter @phumspace/db run seed"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
